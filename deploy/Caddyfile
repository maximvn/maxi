# Reverse proxy met automatisch HTTPS (Let's Encrypt) voor Radiologie Rasterplanner.
# Het domein komt uit deploy/.env (RASTERPLANNER_DOMEIN). Alles gaat door naar de rekenserver;
# die doet zelf login, limieten en beveiligingskoppen (backend/beveiliging.py).
{$RASTERPLANNER_DOMEIN} {
    encode gzip
    # Caddy zet X-Forwarded-For/Proto/Host; de server vertrouwt die met RASTERPLANNER_ACHTER_PROXY=1.
    reverse_proxy rasterplanner:8000 {
        header_up X-Forwarded-Proto {scheme}
        header_up X-Forwarded-Host {host}
    }
    # Grote uploads zijn niet nodig; dit is een extra slot vóór de server.
    request_body {
        max_size 4MB
    }
    log {
        output stdout
        format console
    }
}
