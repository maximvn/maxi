# Kopieer naar deploy/.env en vul in. Dit bestand nooit in git zetten.
POLIRASTER_DOMEIN=raster.jouwziekenhuis.nl

# Wachtwoord voor de login (gebruik een wachtzin van minstens 16 tekens)
POLIRASTER_WACHTWOORD=

# Sleutel voor het ondertekenen van sessiecookies. Maak er één met:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
POLIRASTER_GEHEIM=

# Optioneel: token voor scripts die de API rechtstreeks aanroepen (Authorization: Bearer …)
POLIRASTER_TOKEN=

# Optioneel: afstelling
POLIRASTER_SESSIE_UREN=12
POLIRASTER_GELIJKTIJDIG=2
POLIRASTER_TIMEOUT=120
POLIRASTER_LIMIET=120
POLIRASTER_LOG=INFO
